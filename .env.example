# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Salon où sont envoyés/édités les 2 classements automatiques (24h + all time).
DISCORD_CHANNEL_ID=
# Optionnel mais recommandé : identifiant Discord (utilisateur) qui reçoit en
# MP les échecs de scraping, les alertes "compte bloqué depuis plusieurs
# jours", et la sauvegarde quotidienne des données. Sans cette variable, ces
# 3 mécanismes sont simplement désactivés (le bot continue de fonctionner).
DISCORD_OWNER_ID=

# --- Comptes suivis ---
# Tableau JSON : un objet par compte, avec un "name" (affiché dans le
# classement) et un tableau "urls" à 3 emplacements dans l'ordre
# [Instagram, TikTok, YouTube]. Laissez une chaîne vide "" pour une
# plateforme non suivie sur ce compte (affiché "Ban" dans Discord).
ACCOUNTS=[{"name":"mon_compte","urls":["https://www.instagram.com/xxx/","https://www.tiktok.com/@xxx","https://www.youtube.com/@xxx"]}]

# --- Instagram (scraping par session) ---
# Cookies de session exportés via `npm run export-ig-cookies` (voir README).
# Prioritaire sur IG_COOKIES_PATH si les deux sont présents — pratique sur un
# hébergeur sans système de fichiers persistant (ex. Railway sans volume).
IG_COOKIES_JSON=
# Chemin local vers le fichier de cookies, si vous préférez le fichier à la
# variable (défaut : ./src/ig-cookies.json).
IG_COOKIES_PATH=

# --- TikTok (API tierce, plus de scraping navigateur depuis le 08/08/2026) ---
# Clé de l'API tiktokapi.store, qui renvoie directement les vues par vidéo
# sans passer par un navigateur (TikTok bloque Playwright derrière un
# captcha slider, y compris avec IP résidentielle et patchs anti-détection).
TIKTOK_API_KEY=

# --- Planification ---
# Format cron standard. Un jitter aléatoire de 0 à 120 min est ajouté au
# déclenchement réel (voir src/index.js) pour ne pas partir pile à l'heure
# tous les jours.
CRON_SCHEDULE=0 9 * * *
TIMEZONE=Europe/Paris

# --- Réglages de collecte ---
# Nombre de publications les plus récentes prises en compte par plateforme
# et par compte (défaut 2). Plus la valeur est basse, plus le classement 24h
# est réactif aux nouvelles publications, mais plus il est sensible au
# renouvellement de la fenêtre suivie (voir README, section "vues 24h").
IG_POSTS_LIMIT=2
# Nombre de collectes consécutives en échec sur un compte/plateforme avant
# l'alerte "compte bloqué" en MP (défaut 3).
STUCK_ALERT_MIN_DAYS=3

# --- Chemins de persistance ---
# Sur un hébergeur avec système de fichiers éphémère (Railway sans volume
# monté sur ces chemins précis), ces 3 fichiers sont perdus à chaque
# redéploiement si vous ne les redirigez pas vers un volume persistant —
# vécu concrètement le 09/08/2026 (perte du cumul all-time). En local, les
# valeurs par défaut (./data/...) suffisent.
HISTORY_PATH=./data/history.json
CUMULATIVE_VIEWS_PATH=./data/cumulative-views.json
LAST_MESSAGE_PATH=./data/last-message.json

# --- Debug (ne jamais activer en production) ---
# FAST_MODE=1 réduit drastiquement les délais anti-détection (utile pour un
# test rapide de `npm run scan`, mais rend le pattern de requêtes facilement
# détectable comme automatisé).
FAST_MODE=
# DEBUG_SCRAPE=1 affiche le détail des vues comptées par post/vidéo dans les
# logs, pour diagnostiquer un chiffre suspect.
DEBUG_SCRAPE=
